{
  "id": "shadowrun-edge",
  "title": "Shadowrun Edge",
  "description": "A Shadowrun game system for Foundry VTT: dice pools, hits and glitches, Edge, condition monitors and skills.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    { "name": "V_Cancrosa" }
  ],
  "url": "https://github.com/V-Cancrosa/ShadowRun_Edge",
  "esmodules": ["shadowrun-edge.mjs"],
  "styles": ["styles/shadowrun-edge.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pl", "name": "Polski", "path": "lang/pl.json" }
  ],
  "documentTypes": {
    "Actor": {
      "character": { "htmlFields": ["biography"] },
      "npc": { "htmlFields": ["biography"] }
    },
    "Item": {
      "skill": { "htmlFields": ["description"] },
      "weapon": { "htmlFields": ["description"] },
      "gear": { "htmlFields": ["description"] }
    }
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "primaryTokenAttribute": "monitors.physical",
  "secondaryTokenAttribute": "monitors.stun"
}
