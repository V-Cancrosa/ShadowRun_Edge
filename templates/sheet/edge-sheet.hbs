<div class="sre-es">
  {{!-- Header --}}
  <header class="sre-es-head">
    <button type="button" class="sre-es-theme" data-action="toggleTheme" data-tooltip="{{themeSwitch.label}}" aria-label="{{themeSwitch.label}}">
      <i class="fas {{themeSwitch.icon}}"></i>
    </button>
    <div class="sre-es-portrait" data-action="showPortraitArtwork">
      {{#if img}}<img src="{{img}}" alt="{{name}}">{{else}}<span>{{initial}}</span>{{/if}}
    </div>
    <div class="sre-es-identity">
      <input class="sre-es-name" type="text" name="name" value="{{name}}" {{#unless editable}}disabled{{/unless}}>
      <div class="sre-es-tags">
        {{#each tags}}<span class="sre-es-tag sre-es-tag-{{kind}}">{{text}}</span>{{/each}}
      </div>
      <div class="sre-es-edge">
        <span class="sre-es-edge-label">Edge</span>
        <span class="sre-es-pips">
          {{#each edge.pips}}
          <button type="button" class="sre-es-pip {{#if on}}on{{/if}} {{#unless available}}cap{{/unless}}"
                  data-action="edge" data-value="{{index}}" {{#unless available}}disabled{{/unless}}></button>
          {{/each}}
        </span>
        <strong>{{edge.value}}/{{edge.max}}</strong>
        <button type="button" class="sre-es-mini" data-action="edge" data-delta="1" {{#unless edge.canGain}}disabled{{/unless}}>+1</button>
        <button type="button" class="sre-es-mini" data-action="edge" data-delta="-1" {{#unless edge.canSpend}}disabled{{/unless}}>−1</button>
      </div>
    </div>
    <div class="sre-es-chips">
      {{#each chips}}
      <div class="sre-es-chip {{#if kind}}sre-es-chip-{{kind}}{{/if}}" data-chip="{{id}}">
        <span>{{label}}</span><strong>{{value}}</strong>{{#if extra}} <small>{{extra}}</small>{{/if}}
      </div>
      {{/each}}
    </div>
  </header>

  <nav class="sre-es-tabs">
    {{#each tabs}}
    <button type="button" class="sre-es-tabbtn {{#if active}}active{{/if}}" data-action="showSheetTab" data-tab="{{id}}">{{label}}</button>
    {{/each}}
  </nav>

  <section class="sre-sheet-body">
    {{#if active.main}}
    {{#if warnings.length}}
    <div class="sre-es-warnings">
      {{#each warnings}}<span class="sre-es-warning sre-es-warning-{{level}}">{{text}}</span>{{/each}}
    </div>
    {{/if}}

    <div class="sre-es-grid">
      <div class="sre-es-col">
        {{!-- Condition monitors --}}
        <div class="sre-es-panel">
          <h3>{{localize "SRE.Sheet.Monitors"}} <span>{{localize "SRE.Sheet.MonitorsHint"}}
            <button type="button" class="sre-es-mini" data-action="heal"><i class="fas fa-kit-medical"></i> {{localize "SRE.Heal.Button"}}</button></span></h3>
          {{#each monitors}}
          <div class="sre-es-monitor" data-monitor="{{id}}">
            <span class="sre-es-label">{{label}}</span>
            <span class="sre-es-boxes sre-es-boxes-{{id}}">
              {{#each boxes}}
              <button type="button" class="sre-es-box {{#if filled}}filled{{/if}}" data-action="monitor" data-monitor="{{../id}}" data-index="{{index}}"
                      {{#unless ../../editable}}disabled{{/unless}}>{{label}}</button>
              {{/each}}
            </span>
            <span class="sre-es-count">{{dmg}} / {{max}}</span>
          </div>
          {{/each}}
          <div class="sre-es-wound {{#if wound}}active{{/if}}">
            <span>{{localize "SRE.Sheet.WoundPenalty"}}</span><strong>{{#if wound}}−{{wound}}{{else}}0{{/if}}</strong>
          </div>
        </div>

        {{!-- Initiative --}}
        <div class="sre-es-panel">
          <h3>{{localize "SRE.Sheet.InitiativeTitle"}}</h3>
          {{#each initiative}}
          <div class="sre-es-row">
            <span class="sre-es-grow">{{label}}</span>
            <span class="sre-es-dim">{{base}} + {{dice}}{{localize "SRE.Sheet.D6"}}</span>
            <button type="button" class="sre-es-btn {{#if @first}}solid{{/if}}" data-action="rollInitiative"
                    data-id="{{id}}" data-base="{{base}}" data-dice="{{dice}}" data-label="{{label}}">{{localize "SRE.Sheet.Roll"}}</button>
          </div>
          {{/each}}
          <div class="sre-es-row sre-es-actions">
            <span>{{localize "SRE.Sheet.Actions"}}</span>
            <span class="sre-es-act major">{{actions.major}} {{localize "SRE.Sheet.Major"}}</span>
            <span class="sre-es-act">{{actions.minor}} {{localize "SRE.Sheet.Minor"}}</span>
            <span class="sre-es-dim sre-es-right">{{localize "SRE.Sheet.ActionsHint"}}</span>
          </div>
        </div>

        {{!-- Quick rolls --}}
        <div class="sre-es-panel">
          <h3>{{localize "SRE.Sheet.QuickTitle"}}</h3>
          <div class="sre-es-quick">
            {{#each quick}}
            <button type="button" class="sre-es-qb" data-action="rollQuick" data-kind="{{roll.kind}}" data-id="{{roll.id}}"
                    data-pool="{{raw}}" data-label="{{label}}">
              {{label}} <span class="sre-es-pool">{{value}}{{#if minus}}<small>−{{minus}}</small>{{/if}}</span>
            </button>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="sre-es-col">
        {{!-- Defense --}}
        <div class="sre-es-panel">
          <h3>{{localize "SRE.Sheet.DefenseTitle"}}</h3>
          <div class="sre-es-tiles">
            <div class="sre-es-tile"><span>{{localize "SRE.Sheet.DefenseRating"}}</span><strong>{{defense.rating}}</strong><small>{{localize "SRE.Sheet.DefenseRatingHint"}}</small></div>
            <button type="button" class="sre-es-tile" data-action="rollQuick" data-kind="defense" data-id="physical" data-pool="{{defense.test.raw}}" data-label="{{defense.test.label}}">
              <span>{{defense.test.label}}</span><strong>{{defense.test.value}}</strong><small>{{localize "SRE.Sheet.DefenseTestHint"}}</small>
            </button>
            <button type="button" class="sre-es-tile" data-action="rollQuick" data-kind="soak" data-id="damage_physical" data-pool="{{defense.soak.raw}}" data-label="{{defense.soak.label}}">
              <span>{{defense.soak.label}}</span><strong>{{defense.soak.value}}</strong><small>{{localize "SRE.Sheet.SoakHint"}}</small>
            </button>
          </div>
          <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.Movement"}}</span>
            <span class="sre-es-dim">{{defense.walk}} m / {{localize "SRE.Sheet.Sprint"}} {{defense.sprint}} m (+{{defense.perHit}} m {{localize "SRE.Sheet.PerHit"}})</span></div>
          <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.LiftCarry"}}</span><span class="sre-es-dim">{{defense.liftCarry}}</span></div>
        </div>

        {{!-- In hand: weapons and spells --}}
        <div class="sre-es-panel">
          <h3>{{localize "SRE.Sheet.InHand"}}</h3>
          {{#each weapons}}
          <div class="sre-es-weapon" data-item-id="{{id}}">
            <div class="sre-es-row">
              <a class="sre-es-grow sre-es-itemname" data-action="openItem">{{name}}</a>
              <span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span>
              <button type="button" class="sre-es-btn solid" data-action="rollWeapon">{{localize "SRE.Sheet.Attack"}}</button>
            </div>
            <div class="sre-es-stats">
              <span>DV <b>{{dv}}</b></span>
              {{#if modes}}<span>{{localize "SRE.Sheet.Modes"}} <b>{{modes}}</b></span>{{/if}}
              <span>WA <b>{{ar}}</b></span>
              {{#if ammo}}
              <span class="sre-es-ammo">{{localize "SRE.Sheet.Ammo"}} <b>{{ammo.count}}/{{ammo.cap}}</b>
                <span class="sre-es-rounds">{{#each ammo.rounds}}<i class="{{#unless this}}empty{{/unless}}"></i>{{/each}}</span>
              </span>
              <button type="button" class="sre-es-btn" data-action="reload">{{localize "SRE.Sheet.Reload"}}</button>
              {{/if}}
            </div>
          </div>
          {{/each}}
          {{#each spells}}
          <div class="sre-es-weapon" data-item-id="{{id}}">
            <div class="sre-es-row">
              <a class="sre-es-grow sre-es-itemname" data-action="openItem">{{name}}</a>
              <span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span>
              <button type="button" class="sre-es-btn solid" data-action="rollSpell">{{localize "SRE.Sheet.Cast"}}</button>
            </div>
            <div class="sre-es-stats">
              {{#if category}}<span>{{category}}</span>{{/if}}
              <span>{{localize "SRE.Sheet.Drain"}} <b>{{drain}}</b> ({{localize "SRE.Sheet.DrainResist"}} {{drainPool}})</span>
            </div>
          </div>
          {{/each}}
          {{#unless weapons.length}}{{#unless spells.length}}<p class="sre-es-empty">{{localize "SRE.Sheet.NothingInHand"}}</p>{{/unless}}{{/unless}}
        </div>
      </div>
    </div>
    {{else if active.skills}}
    {{!-- Attributes --}}
    <div class="sre-es-attrs">
      {{#each sk.attributes}}
      <div class="sre-es-attr {{#if special}}special{{/if}}">
        <button type="button" class="sre-es-attr-roll" data-action="rollAttribute" data-id="{{id}}" data-pool="{{value}}" data-label="{{label}}">
          <span class="sre-es-attr-name">{{short}} · {{label}}</span>
          <strong class="{{#if atMax}}max{{/if}}">{{value}}</strong>
        </button>
        <div class="sre-es-attr-foot">
          <label>{{localize "SRE.Sheet.Base"}} <input type="number" name="system.attributes.{{id}}.base" value="{{base}}" min="0" max="15" {{#unless ../editable}}disabled{{/unless}}></label>
          <span class="{{#if mod}}sre-es-aug{{/if}}" data-tooltip="SRE.Sheet.ModHint">{{#if mod}}{{#if (gt mod 0)}}+{{/if}}{{mod}}{{else}}+0{{/if}}</span>
          <span>{{localize "SRE.Sheet.Max"}} {{max}}</span>
        </div>
      </div>
      {{/each}}
      <div class="sre-es-attr special">
        <div class="sre-es-attr-roll"><span class="sre-es-attr-name">Edge</span><strong>{{sk.edgeAttr.value}}</strong></div>
        <div class="sre-es-attr-foot">
          <label>{{localize "SRE.Sheet.Max"}} <input type="number" name="system.edge.max" value="{{sk.edgeAttr.base}}" min="1" max="7" {{#unless editable}}disabled{{/unless}}></label>
          <span>{{localize "SRE.Sheet.Limit"}} {{sk.edgeAttr.cap}}</span>
        </div>
      </div>
      <div class="sre-es-attr special">
        <div class="sre-es-attr-roll"><span class="sre-es-attr-name">{{localize "SRE.Sheet.Essence"}}</span><strong class="sre-es-cyan">{{sk.essence}}</strong></div>
        <div class="sre-es-attr-foot"><span>{{localize "SRE.Sheet.EssenceHint"}}</span></div>
      </div>
    </div>

    {{!-- Active skills --}}
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.ActiveSkills"}}
        <span class="sre-es-filter">{{localize "SRE.Sheet.Show"}}
          <button type="button" class="{{#if sk.showAll}}on{{/if}}" data-action="toggleUntrained" {{#if sk.showAll}}disabled{{/if}}>{{localize "SRE.Sheet.ShowAll"}}</button>
          <button type="button" class="{{#unless sk.showAll}}on{{/unless}}" data-action="toggleUntrained" {{#unless sk.showAll}}disabled{{/unless}}>{{localize "SRE.Sheet.ShowTrained"}} ({{sk.trainedCount}})</button>
        </span>
      </h3>
      <div class="sre-es-skillhead">
        <span>{{localize "SRE.Sheet.Skill"}}</span><span>{{localize "SRE.Sheet.Attr"}}</span><span>{{localize "SRE.Sheet.Points"}}</span>
        <span>{{localize "SRE.Sheet.Pool"}}</span><span>{{localize "SRE.Sheet.Specialization"}}</span><span>{{localize "SRE.Sheet.Expertise"}}</span><span></span>
      </div>
      {{#each sk.skills}}
      <div class="sre-es-skill {{#unless trained}}untrained{{/unless}}" data-skill="{{id}}">
        <span class="sre-es-skillname">{{label}}{{#unless trained}}{{#unless untrainedAllowed}} <small>{{localize "SRE.Sheet.NoUntrained"}}</small>{{/unless}}{{/unless}}</span>
        <span class="sre-es-dim">{{attr}}</span>
        <input type="number" name="system.skills.{{id}}.points" value="{{points}}" min="0" max="12" {{#unless ../editable}}disabled{{/unless}}>
        <span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span>
        <span class="sre-es-spec">
          <select name="system.skills.{{id}}.specialization" {{#unless ../editable}}disabled{{/unless}}>
            <option value="">—</option>
            {{#each specOptions}}<option value="{{value}}" {{#if (eq value ../specialization)}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if specPool includeZero=true}}<button type="button" class="sre-es-pool sre-es-poolbtn" data-action="rollSkill" data-skill="{{id}}" data-spec="{{specialization}}">{{specPool}}</button>{{/if}}
        </span>
        <span class="sre-es-spec">
          <select name="system.skills.{{id}}.expertise" {{#unless ../editable}}disabled{{/unless}}>
            <option value="">—</option>
            {{#each specOptions}}<option value="{{value}}" {{#if (eq value ../expertise)}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          {{#if expPool includeZero=true}}<button type="button" class="sre-es-pool sre-es-poolbtn" data-action="rollSkill" data-skill="{{id}}" data-spec="{{expertise}}">{{expPool}}</button>{{/if}}
        </span>
        <button type="button" class="sre-es-btn solid" data-action="rollSkill" data-skill="{{id}}">{{localize "SRE.Sheet.Roll"}}</button>
      </div>
      {{/each}}
    </div>

    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Knowledge"}}
          {{#if editable}}<button type="button" class="sre-es-mini" data-action="addKnowledge" data-kind="knowledge">+ {{localize "SRE.Sheet.AddShort"}}</button>{{/if}}</h3>
        {{#each sk.knowledge}}
        <div class="sre-es-row" data-item-id="{{id}}">
          <a class="sre-es-grow sre-es-itemname" data-action="openItem">{{name}}</a>
          {{#if ../editable}}<button type="button" class="sre-es-mini" data-action="deleteItem" data-tooltip="SRE.Sheet.Delete">✕</button>{{/if}}
        </div>
        {{else}}<p class="sre-es-empty">{{localize "SRE.Sheet.KnowledgeHint"}}</p>{{/each}}
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Languages"}}
          {{#if editable}}<button type="button" class="sre-es-mini" data-action="addKnowledge" data-kind="language">+ {{localize "SRE.Sheet.AddShort"}}</button>{{/if}}</h3>
        {{#each sk.languages}}
        <div class="sre-es-row" data-item-id="{{id}}">
          <a class="sre-es-grow sre-es-itemname" data-action="openItem">{{name}}</a>
          {{#if native}}<span class="sre-es-badge">{{localize "SRE.Sheet.Native"}}</span>{{/if}}
          {{#if ../editable}}<button type="button" class="sre-es-mini" data-action="deleteItem" data-tooltip="SRE.Sheet.Delete">✕</button>{{/if}}
        </div>
        {{else}}<p class="sre-es-empty">—</p>{{/each}}
      </div>
    </div>

    {{else if active.combat}}
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.Ranged"}}</h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">DV</th><th class="c">{{localize "SRE.Sheet.Modes"}}</th>
          <th>{{localize "SRE.Sheet.ArRanges"}}</th><th>{{localize "SRE.Sheet.Ammo"}}</th><th class="c">{{localize "SRE.Sheet.Pool"}}</th><th></th></tr>
        {{#each combat.ranged}}
        <tr data-item-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a>{{#if extras}}<div class="sre-es-small">{{extras}}</div>{{/if}}</td>
          <td class="c"><b>{{dv}}</b></td>
          <td class="c">{{modes}}</td>
          <td><span class="sre-es-ar">{{#each ar}}<i class="{{#unless this}}na{{/unless}}">{{#if this}}{{this}}{{else}}—{{/if}}</i>{{/each}}</span></td>
          <td>{{#if ammo}}
            <b>{{ammo.count}}/{{ammo.cap}}</b>
            <select class="sre-es-ammotype" data-item-field="system.ammoLoaded" {{#unless ../editable}}disabled{{/unless}}>
              {{#each ammo.types}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            <button type="button" class="sre-es-btn" data-action="reload">{{localize "SRE.Sheet.Reload"}}</button>
          {{else}}—{{/if}}</td>
          <td class="c"><span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span></td>
          <td><button type="button" class="sre-es-btn solid" data-action="rollWeapon">{{localize "SRE.Sheet.Attack"}}</button></td>
        </tr>
        {{else}}<tr><td colspan="7" class="sre-es-empty">{{localize "SRE.Sheet.NoWeapons"}}</td></tr>{{/each}}
      </table>
    </div>

    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Melee"}}</h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">DV</th><th class="c">WA</th><th class="c">{{localize "SRE.Sheet.Pool"}}</th><th></th></tr>
          {{#each combat.melee}}
          <tr data-item-id="{{id}}">
            <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a>{{#if extras}}<div class="sre-es-small">{{extras}}</div>{{/if}}</td>
            <td class="c"><b>{{dv}}</b></td><td class="c">{{arFirst}}</td>
            <td class="c"><span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span></td>
            <td><button type="button" class="sre-es-btn solid" data-action="rollWeapon">{{localize "SRE.Sheet.Attack"}}</button></td>
          </tr>
          {{/each}}
          <tr>
            <td><b>{{localize "SRE.Sheet.Unarmed"}}</b><div class="sre-es-small">{{localize "SRE.Sheet.UnarmedHint"}}</div></td>
            <td class="c"><b>{{combat.unarmed.dv}}</b></td><td class="c">{{combat.unarmed.ar}}</td>
            <td class="c"><span class="sre-es-pool">{{combat.unarmed.pool.value}}{{#if combat.unarmed.pool.minus}}<small>−{{combat.unarmed.pool.minus}}</small>{{/if}}</span></td>
            <td><button type="button" class="sre-es-btn" data-action="rollUnarmed">{{localize "SRE.Sheet.Attack"}}</button></td>
          </tr>
        </table>
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Armor"}} <span>{{localize "SRE.Sheet.DefenseRating"}} {{combat.defenseRating}}</span></h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Rating"}}</th><th class="c">{{localize "SRE.Sheet.Social"}}</th><th class="c">{{localize "SRE.Sheet.Worn"}}</th></tr>
          {{#each combat.armor}}
          <tr data-item-id="{{id}}">
            <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td>
            <td class="c">+{{defense}}</td><td class="c">{{#if social}}+{{social}}{{else}}—{{/if}}</td>
            <td class="c"><button type="button" class="sre-es-toggle {{#if worn}}on{{/if}}" data-action="toggleArmor" {{#unless ../editable}}disabled{{/unless}}></button></td>
          </tr>
          {{else}}<tr><td colspan="4" class="sre-es-empty">{{localize "SRE.Sheet.NoArmor"}}</td></tr>{{/each}}
        </table>
        <div class="sre-es-row sre-es-dim">{{localize "SRE.Sheet.ArmorHint"}}</div>
      </div>
    </div>

    {{#if combat.explosives.length}}
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Blast.Explosives"}} <span>{{localize "SRE.Blast.ExplosivesHint"}}</span></h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">DV ({{localize "SRE.Blast.Zones"}})</th><th class="c">{{localize "SRE.Blast.Radius"}}</th><th class="c">{{localize "SRE.Sheet.Count"}}</th><th></th></tr>
        {{#each combat.explosives}}
        <tr data-item-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td class="c"><b>{{dv}}</b></td><td class="c">{{radius}} m</td>
          <td class="c">{{#if count includeZero=true}}{{count}}{{else}}—{{/if}}</td>
          <td><button type="button" class="sre-es-btn solid" data-action="throwExplosive" {{#unless ../editable}}disabled{{/unless}}>{{localize "SRE.Blast.Throw"}}</button></td>
        </tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Sheet.ResistTitle"}} <span>{{localize "SRE.Sheet.ClickToRoll"}}</span></h3>
      <div class="sre-es-quick">
        {{#each combat.resist}}
        <button type="button" class="sre-es-qb" data-action="rollResist" data-kind="{{kind}}" data-pool="{{raw}}" data-label="{{label}}">
          {{label}} <span class="sre-es-pool">{{value}}{{#if minus}}<small>−{{minus}}</small>{{/if}}</span>
        </button>
        {{/each}}
      </div>
    </div>

    {{else if active.magic}}
    {{#if magic.sustained}}<div class="sre-es-warnings"><span class="sre-es-warning">{{localize "SRE.Sheet.Sustaining"}} {{magic.sustained}} — −{{magic.sustainedPenalty}}</span></div>{{/if}}
    <div class="sre-es-tiles6">
      {{#each magic.tiles}}
      {{#if roll}}
      <button type="button" class="sre-es-ktile" data-action="rollResist" data-kind="defense" data-pool="{{value}}" data-label="{{label}}">
        <span>{{label}}</span><strong>{{value}}</strong><small>{{localize "SRE.Sheet.ClickToRoll"}}</small></button>
      {{else}}
      <div class="sre-es-ktile"><span>{{label}}</span><strong class="{{#if text}}text{{/if}}">{{value}}</strong>{{#if small}}<small>{{small}}</small>{{/if}}</div>
      {{/if}}
      {{/each}}
    </div>
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.Spells"}}</h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th>{{localize "SRE.Sheet.Category"}}</th><th>{{localize "SRE.Sheet.Type"}}</th><th>{{localize "SRE.Sheet.Range"}}</th>
          <th>{{localize "SRE.Sheet.Duration"}}</th><th class="c">{{localize "SRE.Sheet.Drain"}}</th><th class="c">{{localize "SRE.Sheet.Sustained"}}</th><th class="c">{{localize "SRE.Sheet.Pool"}}</th><th></th></tr>
        {{#each magic.spells}}
        <tr data-item-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td>{{category}}</td><td>{{type}}</td><td>{{range}}</td><td>{{duration}}</td>
          <td class="c">{{drain}}</td>
          <td class="c">{{#if canSustain}}<button type="button" class="sre-es-toggle {{#if sustained}}on{{/if}}" data-action="toggleSustain" {{#unless ../editable}}disabled{{/unless}}></button>{{else}}—{{/if}}</td>
          <td class="c"><span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span></td>
          <td><button type="button" class="sre-es-btn solid" data-action="rollSpell">{{localize "SRE.Sheet.Cast"}}</button></td>
        </tr>
        {{else}}<tr><td colspan="9" class="sre-es-empty">{{localize "SRE.Sheet.NoSpells"}}</td></tr>{{/each}}
      </table>
    </div>
    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Rituals"}}</h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Threshold"}}</th><th></th></tr>
          {{#each magic.rituals}}
          <tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td class="c">{{threshold}}</td>
            <td><button type="button" class="sre-es-btn" data-action="rollRitual">{{localize "SRE.Sheet.Ritual"}}</button></td></tr>
          {{else}}<tr><td colspan="3" class="sre-es-empty">—</td></tr>{{/each}}
        </table>
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.FociMetamagic"}}</h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Force"}}</th></tr>
          {{#each magic.foci}}<tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a><div class="sre-es-small">{{localize "SRE.Sheet.Focus"}}</div></td><td class="c">{{rating}}</td></tr>{{/each}}
          {{#each magic.metamagic}}<tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a><div class="sre-es-small">{{localize "SRE.Sheet.Metamagic"}}</div></td><td class="c">—</td></tr>{{/each}}
        </table>
      </div>
    </div>
    {{#if magic.canConjure}}
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Summon.Spirits"}} <span>{{localize "SRE.Summon.Budget"}} {{magic.budget.used}} / {{magic.budget.max}}
        {{#if editable}}<button type="button" class="sre-es-mini" data-action="summon">{{localize "SRE.Summon.Button"}}</button>
        <button type="button" class="sre-es-mini" data-action="banish">{{localize "SRE.Summon.BanishButton"}}</button>{{/if}}</span></h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th>{{localize "SRE.Summon.Type"}}</th><th class="c">{{localize "SRE.Summon.Force"}}</th><th class="c">{{localize "SRE.Summon.ServicesLeft"}}</th><th></th></tr>
        {{#each magic.spirits}}
        <tr data-spirit-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openSpirit">{{name}}</a></td><td>{{type}}</td><td class="c">{{force}}</td>
          <td class="c"><span class="sre-es-count">{{#if owner}}<button type="button" class="sre-es-mini" data-action="spiritServices" data-delta="-1">−</button>{{/if}}<b>{{services}}</b>{{#if owner}}<button type="button" class="sre-es-mini" data-action="spiritServices" data-delta="1">+</button>{{/if}}</span></td>
          <td>{{#if owner}}<button type="button" class="sre-es-mini" data-action="dismissSpirit">{{localize "SRE.Summon.Dismiss"}}</button>{{/if}}</td>
        </tr>
        {{else}}<tr><td colspan="5" class="sre-es-empty">{{localize "SRE.Summon.NoSpirits"}}</td></tr>{{/each}}
      </table>
    </div>
    {{/if}}
    {{#if magic.adept}}
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Sheet.AdeptPowers"}} <span>PP: {{magic.ppUsed}} / {{magic.ppMax}}</span></h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Level"}}</th><th class="c">{{localize "SRE.Sheet.PPCost"}}</th></tr>
        {{#each magic.powers}}<tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td class="c">{{#if level}}{{level}}{{else}}—{{/if}}</td><td class="c">{{cost}}</td></tr>
        {{else}}<tr><td colspan="3" class="sre-es-empty">—</td></tr>{{/each}}
      </table>
    </div>
    {{/if}}

    {{else if active.matrix}}
    <div class="sre-es-tiles6">
      {{#each matrix.tiles}}<div class="sre-es-ktile"><span>{{label}}</span><strong class="{{#if warn}}warn{{/if}}">{{value}}</strong></div>{{/each}}
    </div>
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.Overwatch"}} <span>{{matrix.overwatch.value}} / 40</span></h3>
      <div class="sre-es-meter os"><i style="width: {{matrix.overwatch.pct}}%"></i></div>
    </div>
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Sheet.Devices"}} <span>{{localize "SRE.Sheet.DevicesHint"}}</span></h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th>{{localize "SRE.Sheet.Type"}}</th><th class="c">{{localize "SRE.Sheet.Rating"}}</th><th>A / S / D / F</th><th class="c">{{localize "SRE.Sheet.Slots"}}</th><th class="c">{{localize "SRE.Sheet.Active"}}</th></tr>
        {{#each matrix.devices}}
        <tr data-item-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td>{{type}}</td><td class="c">{{rating}}</td>
          <td><span class="sre-es-asdf">{{#each asdf}}<i><b>{{k}}</b>{{#if v includeZero=true}}{{v}}{{else}}—{{/if}}</i>{{/each}}</span></td>
          <td class="c">{{#if slots}}{{slots}}{{else}}—{{/if}}</td>
          <td class="c"><button type="button" class="sre-es-toggle {{#if active}}on{{/if}}" data-action="toggleDevice" {{#unless ../editable}}disabled{{/unless}}></button></td>
        </tr>
        {{else}}<tr><td colspan="6" class="sre-es-empty">{{localize "SRE.Sheet.NoDevices"}}</td></tr>{{/each}}
      </table>
    </div>
    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Persona"}}</h3>
        {{#each matrix.persona}}<div class="sre-es-row"><span class="sre-es-grow">{{k}}</span><strong>{{v}}</strong></div>{{/each}}
        <div class="sre-es-row sre-es-dim">{{localize "SRE.Sheet.PersonaHint"}}</div>
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Programs"}} {{#if matrix.activeDeck}}<span>{{matrix.activeDeck.name}}</span>{{/if}}</h3>
        {{#if matrix.activeDeck}}
        <div class="sre-es-chiplist" data-item-id="{{matrix.activeDeck.id}}">
          {{#each matrix.activeDeck.programs}}
          <button type="button" class="sre-es-chipbtn {{#if on}}on{{/if}} {{#if hacking}}hacking{{/if}}" data-action="toggleProgram" data-program="{{id}}" {{#unless ../../editable}}disabled{{/unless}}>{{label}}</button>
          {{/each}}
        </div>
        {{else}}<p class="sre-es-empty">{{localize "SRE.Sheet.NoDeck"}}</p>{{/if}}
      </div>
    </div>
    {{#if matrix.technomancer}}
    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.ComplexForms"}} <span>{{localize "SRE.Sheet.FadingResist"}} {{matrix.fadingPool}}</span></h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Fading"}}</th><th class="c">{{localize "SRE.Sheet.Sustained"}}</th><th class="c">{{localize "SRE.Sheet.Pool"}}</th><th></th></tr>
          {{#each matrix.forms}}
          <tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a><div class="sre-es-small">{{duration}}</div></td><td class="c">{{fading}}</td>
            <td class="c">{{#if canSustain}}<button type="button" class="sre-es-toggle {{#if sustained}}on{{/if}}" data-action="toggleSustain" {{#unless ../editable}}disabled{{/unless}}></button>{{else}}—{{/if}}</td>
            <td class="c"><span class="sre-es-pool">{{pool.value}}{{#if pool.minus}}<small>−{{pool.minus}}</small>{{/if}}</span></td><td><button type="button" class="sre-es-btn solid" data-action="rollForm">{{localize "SRE.Sheet.Thread"}}</button></td></tr>
          {{else}}<tr><td colspan="5" class="sre-es-empty">—</td></tr>{{/each}}
        </table>
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Echoes"}}</h3>
        {{#each matrix.echoes}}<div class="sre-es-row" data-item-id="{{id}}"><a class="sre-es-itemname" data-action="openItem">{{name}}</a></div>{{else}}<p class="sre-es-empty">—</p>{{/each}}
      </div>
    </div>
    {{/if}}
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Sheet.MatrixActions"}}
        <button type="button" class="sre-es-mini" data-action="toggleAllActions">{{#if matrix.showAllActions}}{{localize "SRE.Sheet.CommonActions"}}{{else}}{{localize "SRE.Sheet.AllActions"}}{{/if}}</button></h3>
      <div class="sre-es-quick">
        {{#each matrix.actions}}
        <button type="button" class="sre-es-qb {{#if illegal}}illegal{{/if}}" data-action="rollMatrix" data-matrix-id="{{id}}">{{label}} <span class="sre-es-pool">{{value}}{{#if minus}}<small>−{{minus}}</small>{{/if}}</span></button>
        {{/each}}
      </div>
    </div>

    {{else if active.gear}}
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.Essence"}} <span>{{gear.essence}} / 6.00</span></h3>
      <div class="sre-es-meter"><i style="width: {{gear.essencePct}}%"></i></div>
    </div>
    <div class="sre-es-panel sre-es-gap">
      <h3>{{localize "SRE.Sheet.Augmentations"}}</h3>
      <table class="sre-es-table">
        <tr><th>{{localize "SRE.Sheet.Name"}}</th><th>{{localize "SRE.Sheet.Type"}}</th><th class="c">{{localize "SRE.Sheet.Grade"}}</th><th class="c">{{localize "SRE.Sheet.Rating"}}</th><th class="c">{{localize "SRE.Sheet.Essence"}}</th><th class="c">{{localize "SRE.Sheet.Capacity"}}</th></tr>
        {{#each gear.augments}}
        <tr data-item-id="{{id}}">
          <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a>{{#if extras}}<div class="sre-es-small">{{extras}}</div>{{/if}}</td><td>{{type}}</td>
          <td class="c"><span class="sre-es-grade {{#if standard}}dim{{/if}}">{{grade}}</span></td>
          <td class="c">{{#if rating}}{{rating}}{{else}}—{{/if}}</td><td class="c sre-es-cyan">{{essence}}</td><td class="c">{{#if capacity}}{{capacity}}{{else}}—{{/if}}</td>
        </tr>
        {{else}}<tr><td colspan="6" class="sre-es-empty">{{localize "SRE.Sheet.NoAugments"}}</td></tr>{{/each}}
      </table>
    </div>
    <div class="sre-es-gearcols">
      {{#each gear.groups}}
      <div class="sre-es-panel">
        <h3>{{label}}</h3>
        <table class="sre-es-table">
          <tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Rating"}}</th><th class="c">{{localize "SRE.Sheet.Count"}}</th></tr>
          {{#each items}}
          <tr data-item-id="{{id}}">
            <td><a class="sre-es-itemname" data-action="openItem">{{name}}</a>{{#if extras}}<div class="sre-es-small">{{extras}}</div>{{/if}}</td>
            <td class="c">{{#if rating includeZero=true}}{{rating}}{{else}}—{{/if}}</td>
            <td class="c">{{#if countable}}<span class="sre-es-count">
              <button type="button" class="sre-es-mini" data-action="count" data-delta="-1" {{#unless ../../editable}}disabled{{/unless}}>−</button><b>{{count}}</b>
              <button type="button" class="sre-es-mini" data-action="count" data-delta="1" {{#unless ../../editable}}disabled{{/unless}}>+</button></span>{{else}}—{{/if}}</td>
          </tr>
          {{/each}}
        </table>
      </div>
      {{/each}}
      {{#if gear.loose.length}}
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.LooseMods"}}</h3>
        {{#each gear.loose}}<div class="sre-es-row" data-item-id="{{id}}"><a class="sre-es-itemname" data-action="openItem">{{name}}</a></div>{{/each}}
      </div>
      {{/if}}
    </div>
    {{#unless gear.groups.length}}<p class="sre-es-empty">{{localize "SRE.Sheet.NoGear"}}</p>{{/unless}}

    {{else if active.social}}
    <div class="sre-es-panel">
      <h3>{{localize "SRE.Sheet.Contacts"}} {{#if editable}}<button type="button" class="sre-es-mini" data-action="addContact">+ {{localize "SRE.Sheet.AddShort"}}</button>{{/if}}</h3>
      <div class="sre-es-cards">
        {{#each social.contacts}}
        <div class="sre-es-card" data-item-id="{{id}}">
          <a class="sre-es-itemname" data-action="openItem">{{name}}</a>{{#if type}}<div class="sre-es-small">{{type}}</div>{{/if}}
          <div class="sre-es-cardstats">
            <span>{{localize "SRE.Sheet.Connection"}} <span class="sre-es-dots">{{#each ratingDots}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span> <strong>{{rating}}</strong></span>
            <span>{{localize "SRE.Sheet.Loyalty"}} <span class="sre-es-dots c">{{#each loyaltyDots}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span> <strong>{{loyalty}}</strong></span>
          </div>
          <div class="sre-es-cardfoot">
            <button type="button" class="sre-es-btn solid" data-action="rollLegwork">{{localize "SRE.Sheet.Legwork"}} ({{legwork}})</button>
            {{#if favors}}<span class="sre-es-small">{{localize "SRE.Sheet.Favors"}}: {{favors}}</span>{{/if}}
          </div>
        </div>
        {{else}}<p class="sre-es-empty">{{localize "SRE.Sheet.NoContacts"}}</p>{{/each}}
      </div>
    </div>
    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Sins"}}</h3>
        <table class="sre-es-table"><tr><th>{{localize "SRE.Sheet.Name"}}</th><th class="c">{{localize "SRE.Sheet.Quality"}}</th></tr>
          {{#each social.sins}}<tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td class="c">{{quality}}</td></tr>
          {{else}}<tr><td colspan="2" class="sre-es-empty">—</td></tr>{{/each}}</table>
      </div>
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.Lifestyles"}}</h3>
        <table class="sre-es-table"><tr><th>{{localize "SRE.Sheet.Name"}}</th><th>{{localize "SRE.Sheet.Type"}}</th><th class="c">{{localize "SRE.Sheet.Cost"}}</th><th class="c">{{localize "SRE.Sheet.Paid"}}</th></tr>
          {{#each social.lifestyles}}<tr data-item-id="{{id}}"><td><a class="sre-es-itemname" data-action="openItem">{{name}}</a></td><td>{{type}}</td><td class="c">{{cost}}¥</td><td class="c">{{paid}}</td></tr>
          {{else}}<tr><td colspan="4" class="sre-es-empty">—</td></tr>{{/each}}</table>
      </div>
    </div>
    <div class="sre-es-two">
      <div class="sre-es-panel">
        <h3>{{localize "SRE.Sheet.KarmaRep"}}</h3>
        <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.KarmaSpendTotal"}}</span>
          <input type="number" name="system.karma" value="{{social.karma}}" {{#unless editable}}disabled{{/unless}}> <span class="sre-es-dim">/</span>
          <input type="number" name="system.karma_total" value="{{social.karmaTotal}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.Reputation"}}</span><input type="number" name="system.reputation" value="{{social.reputation}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.Heat"}}</span><input type="number" name="system.heat" value="{{social.heat}}" {{#unless editable}}disabled{{/unless}}></div>
        <div class="sre-es-row"><span class="sre-es-grow">{{localize "SRE.Sheet.Nuyen"}}</span><input type="number" class="wide" name="system.nuyen" value="{{social.nuyen}}" {{#unless editable}}disabled{{/unless}}></div>
      </div>
      {{#if social.hasDescription}}
      <div class="sre-es-panel sre-es-editor">
        <h3>{{localize "SRE.Sheet.Description"}}</h3>
        <prose-mirror name="system.description" value="{{social.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{social.descriptionHTML}}}</prose-mirror>
      </div>
      {{/if}}
    </div>
    <div class="sre-es-panel sre-es-gap sre-es-editor">
      <h3>{{localize "SRE.Sheet.Notes"}}</h3>
      <prose-mirror name="system.notes" value="{{social.notes}}" toggled {{#unless editable}}disabled{{/unless}}>{{{social.notesHTML}}}</prose-mirror>
    </div>

    {{else}}
    <div class="sre-es-soon">
      <p>{{localize "SRE.Sheet.Soon"}}</p>
      <button type="button" class="sre-es-btn solid" data-action="systemSheet">{{localize "SRE.Sheet.OpenSystemSheet"}}</button>
    </div>
    {{/if}}
  </section>
</div>
