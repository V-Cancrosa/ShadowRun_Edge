<div class="sre-sheet">
  <header class="sre-header">
    <img class="profile" src="{{document.img}}" alt="{{document.name}}" data-action="editImage" data-edit="img">
    <input class="sre-name" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'Name'}}">
  </header>

  <section class="sre-section">
    {{#if isSkill}}
      {{formGroup systemFields.rating value=system.rating localize=true}}
      {{formGroup systemFields.attribute value=system.attribute localize=true}}
      {{formGroup systemFields.specialization value=system.specialization localize=true}}
    {{/if}}

    {{#if isWeapon}}
      {{formGroup systemFields.damage value=system.damage localize=true}}
      {{formGroup systemFields.damageType value=system.damageType localize=true}}
      {{formGroup systemFields.attackRating value=system.attackRating localize=true}}
      {{formGroup systemFields.skill value=system.skill localize=true hint=(localize "SRE.SkillNameHint")}}
      {{formGroup systemFields.attribute value=system.attribute localize=true}}
    {{/if}}

    {{#if isGear}}
      {{formGroup systemFields.quantity value=system.quantity localize=true}}
      {{formGroup systemFields.cost value=system.cost localize=true}}
    {{/if}}
  </section>

  <section class="sre-section">
    <h2>{{localize "SRE.Description"}}</h2>
    {{formInput systemFields.description value=system.description enriched=descriptionHTML toggled=true}}
  </section>
</div>
