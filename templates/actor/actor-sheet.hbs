<div class="sre-sheet">
  <header class="sre-header">
    <img class="profile" src="{{document.img}}" alt="{{document.name}}" data-action="editImage" data-edit="img">
    <div class="sre-header-fields">
      <input class="sre-name" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'Name'}}">
      <div class="sre-row">
        {{formGroup systemFields.metatype value=system.metatype localize=true}}
        {{#if isNpc}}
          {{formGroup systemFields.professionalRating value=system.professionalRating localize=true}}
        {{else}}
          {{formGroup systemFields.nuyen value=system.nuyen localize=true}}
          {{formGroup systemFields.karma value=system.karma localize=true}}
        {{/if}}
      </div>
    </div>
  </header>

  <section class="sre-section">
    <h2>{{localize "SRE.Attributes"}}</h2>
    <div class="sre-attributes">
      {{#each attributes}}
        <div class="sre-attribute">
          <a class="sre-rollable" data-action="rollAttribute" data-attribute="{{key}}">
            <i class="fa-solid fa-dice-d6"></i> {{localize label}}
          </a>
          <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="0" step="1">
        </div>
      {{/each}}
      <div class="sre-attribute">
        <span>{{localize "SRE.Essence"}}</span>
        <input type="number" name="system.essence" value="{{system.essence}}" min="0" step="0.1">
      </div>
    </div>
  </section>

  <section class="sre-section sre-status">
    <div class="sre-monitor">
      <h3>{{localize "SRE.Monitor.physical"}}</h3>
      <input type="number" name="system.monitors.physical.value" value="{{system.monitors.physical.value}}" min="0" max="{{system.monitors.physical.max}}"> / {{system.monitors.physical.max}}
    </div>
    <div class="sre-monitor">
      <h3>{{localize "SRE.Monitor.stun"}}</h3>
      <input type="number" name="system.monitors.stun.value" value="{{system.monitors.stun.value}}" min="0" max="{{system.monitors.stun.max}}"> / {{system.monitors.stun.max}}
    </div>
    <div class="sre-monitor">
      <h3>{{localize "SRE.EdgePoints"}}</h3>
      <input type="number" name="system.edge.value" value="{{system.edge.value}}" min="0" max="{{system.edge.max}}"> / {{system.edge.max}}
    </div>
    <div class="sre-monitor">
      <h3>{{localize "SRE.Initiative"}}</h3>
      <span>{{system.initiative.base}} + {{system.initiative.dice}}d6</span>
      <p class="sre-hint">{{localize "SRE.WoundModifier"}}: {{system.woundModifier}}</p>
    </div>
  </section>

  <section class="sre-section">
    <h2>
      {{localize "SRE.Skills"}}
      {{#if editable}}<a class="sre-add" data-action="createItem" data-type="skill" data-tooltip="SRE.Add"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h2>
    <ol class="sre-items">
      {{#each skills}}
        <li class="sre-item" data-item-id="{{item.id}}">
          <a class="sre-rollable sre-item-name" data-action="rollItem"><i class="fa-solid fa-dice-d6"></i> {{item.name}}</a>
          <span class="sre-item-detail">{{item.system.rating}} + {{localize attributeLabel}}</span>
          <span class="sre-item-pool" data-tooltip="SRE.DicePool">{{pool}}</span>
          <a data-action="editItem" data-tooltip="SRE.Edit"><i class="fa-solid fa-pen"></i></a>
          {{#if @root.editable}}<a data-action="deleteItem" data-tooltip="SRE.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </li>
      {{/each}}
    </ol>
  </section>

  <section class="sre-section">
    <h2>
      {{localize "SRE.Weapons"}}
      {{#if editable}}<a class="sre-add" data-action="createItem" data-type="weapon" data-tooltip="SRE.Add"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h2>
    <ol class="sre-items">
      {{#each weapons}}
        <li class="sre-item" data-item-id="{{id}}">
          <a class="sre-rollable sre-item-name" data-action="rollItem"><i class="fa-solid fa-crosshairs"></i> {{name}}</a>
          <span class="sre-item-detail">{{system.damage}}{{system.damageType}} {{#if system.attackRating}}· {{system.attackRating}}{{/if}}</span>
          <a data-action="editItem" data-tooltip="SRE.Edit"><i class="fa-solid fa-pen"></i></a>
          {{#if @root.editable}}<a data-action="deleteItem" data-tooltip="SRE.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </li>
      {{/each}}
    </ol>
  </section>

  <section class="sre-section">
    <h2>
      {{localize "SRE.GearList"}}
      {{#if editable}}<a class="sre-add" data-action="createItem" data-type="gear" data-tooltip="SRE.Add"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h2>
    <ol class="sre-items">
      {{#each gear}}
        <li class="sre-item" data-item-id="{{id}}">
          <span class="sre-item-name">{{name}}</span>
          <span class="sre-item-detail">×{{system.quantity}}</span>
          <a data-action="editItem" data-tooltip="SRE.Edit"><i class="fa-solid fa-pen"></i></a>
          {{#if @root.editable}}<a data-action="deleteItem" data-tooltip="SRE.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </li>
      {{/each}}
    </ol>
  </section>

  <section class="sre-section">
    <h2>{{localize "SRE.Biography"}}</h2>
    {{formInput systemFields.biography value=system.biography enriched=biographyHTML toggled=true}}
  </section>
</div>
